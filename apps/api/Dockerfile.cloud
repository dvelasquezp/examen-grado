# Imagen API mínima para revisión en la nube (Render).
# Contexto de build: raíz del repositorio

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/alembic.ini ./
COPY apps/api/alembic ./alembic/
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

COPY apps/api/src ./src/

# Materiales mínimos en disco: la ingesta vive en Neon, pero el enriquecimiento
# de definiciones lee MEMORIZADOR CIVIL.pdf (texto nativo, sin OCR).
RUN mkdir -p "/app/content/DERECHO CIVIL 2"
COPY ["DERECHO CIVIL 2/MEMORIZADOR CIVIL.pdf", "/app/content/DERECHO CIVIL 2/MEMORIZADOR CIVIL.pdf"]

ENV CONTENT_PATH=/app/content
ENV APP_ENV=production
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
