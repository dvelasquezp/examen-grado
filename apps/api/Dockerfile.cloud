# Imagen API para revisión en la nube (Render / Fly).
# Contexto de build: raíz del repositorio
#   docker build -f apps/api/Dockerfile.cloud -t examen-api .

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/alembic.ini ./
COPY apps/api/alembic ./alembic/
RUN pip install --no-cache-dir .

COPY apps/api/src ./src/
COPY apps/api/docker-entrypoint.cloud.sh /app/docker-entrypoint.cloud.sh
RUN chmod +x /app/docker-entrypoint.cloud.sh

# Materiales jurídicos (solo lectura)
COPY ["Derecho Civil", "/app/content/Derecho Civil"]
COPY ["Cedulario Examen de Grado.pdf", "/app/content/Cedulario Examen de Grado.pdf"]
# Seed: importar en Neon con scripts/import_seed_neon.sh (RESTORE_SEED=false)

ENV CONTENT_PATH=/app/content
ENV APP_ENV=production

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.cloud.sh"]
